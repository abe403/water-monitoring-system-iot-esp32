# Copy to secrets.yaml (gitignored) and fill in real values.
# Generate strong random passwords, e.g.: openssl rand -base64 18

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

water_level_api_encryption_key: "run: openssl rand -base64 32"
water_level_ap_password: "generate-a-random-16-char-string"

pump_controller_api_encryption_key: "run: openssl rand -base64 32"
pump_controller_ap_password: "generate-a-different-random-16-char-string"

mqtt_broker_host: "mqtt.example.internal"
mqtt_broker_port: 1883
mqtt_username: "device-username"
mqtt_password: "device-password"
